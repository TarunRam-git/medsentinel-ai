{
  "name": "medsentinel-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node scripts/test-api.mjs",
    "setup": "node scripts/setup.mjs",
    "ml:train": ".venv/bin/python -m ml.train",
    "ml:serve": "node scripts/start-ml.mjs",
    "user:create": "tsx scripts/create-user.ts",
    "format": "prettier --write src db docs scripts tests *.json *.ts *.mjs *.md .github/workflows/*.yml",
    "format:check": "prettier --check src db docs scripts tests *.json *.ts *.mjs *.md .github/workflows/*.yml"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
